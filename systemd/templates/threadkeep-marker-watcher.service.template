[Unit]
Description=Threadkeep Discord Marker Watcher
After=network-online.target

[Service]
Type=simple
Environment="THREADKEEP_REPO_ROOT=__REPO_ROOT__"
Environment="THREADKEEP_CONFIG=__REPO_ROOT__/config.toml"
Environment="PYTHONUNBUFFERED=1"
WorkingDirectory=__REPO_ROOT__
ExecStart=__PYTHON_BIN__ __REPO_ROOT__/discord-gateway/marker-watcher.py
Restart=on-failure
RestartSec=10
StandardOutput=append:__REPO_ROOT__/discord-gateway/logs/marker-watcher.stdout.log
StandardError=append:__REPO_ROOT__/discord-gateway/logs/marker-watcher.stderr.log

[Install]
WantedBy=default.target
