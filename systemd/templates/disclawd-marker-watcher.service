[Unit]
Description=Claude Disclawd Discord Marker Watcher
After=network-online.target

[Service]
Type=simple
Environment="DISCLAWD_CONFIG=__REPO_ROOT__/config.toml"
Environment="PYTHONUNBUFFERED=1"
WorkingDirectory=__REPO_ROOT__
ExecStart=/usr/bin/python3 __REPO_ROOT__/discord-gateway/marker-watcher.py
Restart=on-failure
RestartSec=10
StandardOutput=append:__REPO_ROOT__/discord-gateway/logs/marker-watcher.stdout.log
StandardError=append:__REPO_ROOT__/discord-gateway/logs/marker-watcher.stderr.log

[Install]
WantedBy=default.target
