[Unit]
Description=Claude Disclawd Discord Gateway Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="DISCLAWD_CONFIG=__REPO_ROOT__/config.toml"
Environment="PYTHONUNBUFFERED=1"
WorkingDirectory=__REPO_ROOT__
ExecStart=/usr/bin/python3 __REPO_ROOT__/discord-gateway/client.py
Restart=on-failure
RestartSec=10
StandardOutput=append:__REPO_ROOT__/discord-gateway/logs/launchd.stdout.log
StandardError=append:__REPO_ROOT__/discord-gateway/logs/launchd.stderr.log

[Install]
WantedBy=default.target
