# Disco Party non-secret environment variable examples.
#
# Nothing in Disco Party auto-loads a `.env` file. These keys are examples for
# a process manager, direnv-style local setup, or temporary developer overrides.
# Environment variables override config.toml where the loader supports them.
#
# Bot tokens are intentionally absent. Store their source values in Keychain:
#   Claude: service discoparty-secret, account discord-bot-token
#   Codex:  service discoparty-secret, account discord-bot-token-codex
# The Claude launcher injects its Keychain token directly into the pinned
# process. It rejects any stale plugin .env and never writes a token file.
# Do not put real credentials in this example, config.toml, a plist, or Git.

# ----- Shared paths -----
DISCOPARTY_REPO_ROOT=
DISCOPARTY_CONFIG=
DISCOPARTY_VAULT_ROOT=
DISCOPARTY_CONVERSATIONS_DIR=
DISCOPARTY_LOG_FILE=

# ----- Claude Discord identifiers -----
DISCOPARTY_DISCORD_GUILD_ID=
DISCOPARTY_LISTEN_CHANNEL_ID=
DISCOPARTY_ERRORS_CHANNEL_ID=
DISCOPARTY_OWNER_USER_ID=
DISCOPARTY_DISCORD_BOT_USER_ID=
DISCOPARTY_DISCORD_APPLICATION_ID=

# ----- Shared runtime -----
DISCOPARTY_TIMEZONE=UTC

# ----- Retired Claude outbound watcher variables -----
# The production installer removes the old marker-watcher and does not load
# outbound adapters. These names are intentionally not offered as live config.
DISCOPARTY_BOT_TOKEN_ENV=DISCORD_BOT_TOKEN

# ----- Optional Codex provider -----
DISCOPARTY_CODEX_ENABLED=false
# Use a dedicated application and bot that belong only to this one guild.
DISCOPARTY_CODEX_GUILD_ID=
DISCOPARTY_CODEX_CHANNEL_ID=
DISCOPARTY_CODEX_OWNER_USER_ID=
DISCOPARTY_CODEX_BOT_USER_ID=
DISCOPARTY_CODEX_APPLICATION_ID=
# public is the default and is not a confidentiality boundary. owner_private
# requires a private parent channel readable only by the guild owner and this
# dedicated bridge bot; runtime permission and audience checks fail closed.
DISCOPARTY_CODEX_CHANNEL_TRUST=public
DISCOPARTY_CODEX_WORKING_DIRECTORY=
# Optional. New installs default to ~/Library/Application Support/Discoparty/codex-discord.
# Installer and runtime accept overrides only as explicit subpaths below
# canonical ~/Library/Application Support/Discoparty and reject unsafe ancestry.
DISCOPARTY_CODEX_STATE_DIR=
# If set, this must remain exactly STATE_DIR/home/.codex.
DISCOPARTY_CODEX_HOME=
DISCOPARTY_CODEX_BIN=/opt/homebrew/bin/codex
# In danger-full-access mode, leaving this empty selects and hashes the
# canonical Vault CLAUDE.md. Workspace project documents remain disabled.
DISCOPARTY_CODEX_INSTRUCTIONS_FILE=

# Sandbox authority is independent of destination trust. danger-full-access
# requires only the exact explicit acceptance below and remains uncontained.
DISCOPARTY_CODEX_SANDBOX_MODE=workspace-write
DISCOPARTY_CODEX_FULL_COMPUTER_ACCESS_ACCEPTED=false

# The installer keeps the canonical macOS HOME so official keyring mode can use
# the default Keychain. It supplies a private CODEX_HOME below state_dir, runs
# the official ChatGPT browser login in that scope, and rejects auth.json.
# Normal ~/.codex is not reused. codex_home must remain exactly
# state_dir/home/.codex.

# ----- Codex admission and storage limits -----
# The message rate defaults inherit [runtime] unless explicitly overridden.
DISCOPARTY_CODEX_MAX_MESSAGES_PER_MINUTE=5
DISCOPARTY_CODEX_MAX_MESSAGES_PER_HOUR=30
DISCOPARTY_CODEX_MAX_CONCURRENT_WORKERS=3
DISCOPARTY_CODEX_MAX_PENDING_JOBS=100
DISCOPARTY_CODEX_MAX_INPUT_CHARS=12000
DISCOPARTY_CODEX_RETENTION_DAYS=30
DISCOPARTY_CODEX_MAX_DATABASE_BYTES=268435456
