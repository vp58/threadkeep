# Threadkeep environment variables.
#
# Every key here is also settable in config.toml. Env vars always win over
# the TOML file so you can keep secrets out of the repo. Copy this file to
# `.env` next to your config.toml if you want a local override file. Nothing
# in Threadkeep auto-loads `.env`, so source it from your shell or pass the
# vars in via your process manager (launchd, systemd, tmux, direnv, etc.).

# ----- Required: Discord bot token -----
# Bot token for your Discord application. Required for every component.
# On macOS the install.sh script stores this in the macOS Keychain under
# service "threadkeep-secret", account "discord-bot-token", and the launched
# processes source it from there. You only need to set this env var if you
# are running components by hand outside of launchd/systemd.
DISCORD_BOT_TOKEN=

# ----- Required: Discord identifiers -----
# Channel id Threadkeep listens to. Top-level posts here become new threads.
THREADKEEP_LISTEN_CHANNEL_ID=
# Channel id Threadkeep posts errors and stderr to. May be the same as listen.
THREADKEEP_ERRORS_CHANNEL_ID=
# Discord user id of the owner. Only this user can approve outbound sends
# and only their button presses are honored by the router.
THREADKEEP_OWNER_USER_ID=

# ----- Optional: paths -----
# Override the repo root. install.sh sets this when wiring launchd plists so
# the daemons can find conversations/, approval/, discord-gateway/ etc.
THREADKEEP_REPO_ROOT=
# Override the path to the config file (defaults to <repo>/config.toml,
# falling back to <repo>/config.example.toml when unset).
THREADKEEP_CONFIG=
# Override workspace root (where conversation transcripts live).
THREADKEEP_VAULT_ROOT=
# Override conversations dir (defaults to <workspace>/conversations).
THREADKEEP_CONVERSATIONS_DIR=
# Optional log file. Defaults to per-component logs under the repo.
THREADKEEP_LOG_FILE=
# Optional plaintext token file. Used only when DISCORD_BOT_TOKEN is unset
# and macOS Keychain access is unavailable. Keep chmod 600 and out of git.
THREADKEEP_TOKEN_FILE=

# ----- Optional: runtime -----
# IANA timezone for transcript timestamps. Defaults to UTC.
THREADKEEP_TIMEZONE=

# ----- Optional: outbound gate scripts (marker watcher) -----
# Path to a user-supplied Slack post script. The marker watcher invokes this
# script when an approved marker has operation starting with "slack_". The
# script receives --pending-json with the full pending context. See
# docs/ARCHITECTURE.md for the gate script contract.
THREADKEEP_SLACK_GATE=
# Path to a user-supplied email send script. Invoked when operation is
# "gmail_send". Same contract as the slack gate.
THREADKEEP_EMAIL_GATE=

# ----- Optional: outbound send hook (Claude Code PreToolUse) -----
# Space-separated list of script basenames that the outbound-send-gate-hook.sh
# Claude Code hook should refuse to run without a verified Discord approval
# reference in the command line.
THREADKEEP_GATED_SCRIPTS=
# Env var name the bot token lives in. Defaults to DISCORD_BOT_TOKEN.
THREADKEEP_BOT_TOKEN_ENV=
